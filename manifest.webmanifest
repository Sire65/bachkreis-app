{
  "name": "Bachkreis Bergkamen",
  "short_name": "Bachkreis",
  "description": "Termine, Zusagen, Nachrichten, Instrumente und Noten des Bachkreises",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f3ea",
  "theme_color": "#1a1500",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titel",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "dateien",
          "accept": [
            "application/pdf",
            "image/*",
            "audio/*",
            "text/plain",
            ".pdf",
            ".doc",
            ".docx",
            ".xls",
            ".xlsx",
            ".odt",
            ".ods",
            ".txt"
          ]
        }
      ]
    }
  }
}
